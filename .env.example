# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Guild (server) ID - right-click your server in Discord, then Copy ID
GUILD_ID=your_guild_id_here

# FFmpeg audio input device - see README for how to find yours
# Windows (DirectShow): audio=CABLE Output (VB-Audio Virtual Cable)
# macOS (AVFoundation): :BlackHole 2ch
AUDIO_INPUT=audio=CABLE Output (VB-Audio Virtual Cable)
